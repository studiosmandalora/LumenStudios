# Lumen Studios — Environment Configuration (template)
# Copy this file to .env and fill in the values.

# Server
PORT=3000
CORS_ORIGIN=*

# Email — inquiries are delivered to studios.lumen@proton.me
# Supported: Proton Mail Bridge, Gmail SMTP, Mailgun, SendGrid, etc.
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_USER=your-smtp-username
EMAIL_PASSWORD=your-smtp-password
EMAIL_FROM=studios.lumen@proton.me

# Business email — where inquiries are sent
BUSINESS_EMAIL=studios.lumen@proton.me
