# Lumen Studios — Environment Configuration (template)
# Copy this file to .env and fill in the values.

# Server
PORT=3000
CORS_ORIGIN=*

# Web3Forms — Contact form email delivery
# Sign up free at https://web3forms.com — no domain needed
# Inquiries are forwarded to studios.lumen@proton.me
WEB3FORMS_ACCESS_KEY=your_access_key_here

# Business email — where inquiries are sent
BUSINESS_EMAIL=studios.lumen@proton.me
